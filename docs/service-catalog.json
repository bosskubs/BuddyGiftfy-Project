{
  "baseUrl": "http://localhost:3001",
  "prerequisites": [
    "ใช้ฐานข้อมูลสาธิตเท่านั้น คำขอเปลี่ยนข้อมูลจริง",
    "GET /api/session แล้วเก็บ bg_session cookie และ session.csrf",
    "หลัง login/register/logout ให้ GET /api/session อีกครั้งเพื่อใช้ CSRF ใหม่",
    "ใช้บัญชี demo ใน SQL และแทน {{demoPassword}} ตามคู่มือ",
    "ID/หมายเลขออเดอร์/token/ไฟล์ภาพต้องมาจากข้อมูลที่สร้างในขั้นก่อน",
    "ออเดอร์ตัวอย่าง A/B ใช้คนละรายการเมื่อคำสั่งเปลี่ยนสถานะหรือยกเลิก",
    "{{imageDataUrl}} คือ data:image/png;base64,... หรือ JPEG ของไฟล์ไม่เกิน 5 MB ไม่ใช่ข้อความตัวย่อ",
    "ตัวอย่างที่จงใจผิดคาดหวัง 4xx; legacy-payment-status คาดหวัง 400 เสมอ"
  ],
  "services": [
