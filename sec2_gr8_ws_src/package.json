{
  "name": "buddygiftfy-web-services",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node --env-file-if-exists=.env src/server.js",
    "dev": "node --env-file-if-exists=.env --watch src/server.js",
    "db:migrate": "node --env-file-if-exists=.env scripts/migrate.js",
    "db:seed": "node --env-file-if-exists=.env src/seed.js",
    "db:seed-catalog": "node --env-file-if-exists=.env scripts/seed-demo-catalog.js",
    "db:backup": "node --env-file-if-exists=.env scripts/backup.js"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "mysql2": "^3.14.0",
    "sharp": "^0.35.5"
  }
}
